<%- include('../layouts/header') %>

<div class="max-w-md mx-auto my-8">
  <div class="bg-white rounded-3xl border-2 border-[#ba1414]/20 p-8 shadow-xl">
    
    <!-- Header -->
    <div class="text-center mb-6">
      <div class="w-14 h-14 mx-auto rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center text-2xl font-black mb-3 border border-amber-200">
        ✉️
      </div>
      <h1 class="text-2xl font-black text-[#ba1414] tracking-tight">Activate Your Account</h1>
      <p class="text-xs text-slate-500 mt-1">
        We sent a 6-digit verification code to
        <span class="font-bold text-slate-800"><%= email || 'your email' %></span>
      </p>
    </div>

    <!-- Success / Notice -->
    <% if (typeof msg !== 'undefined' && msg === 'otp_sent') { %>
      <div class="mb-5 p-3.5 rounded-2xl bg-emerald-50 border border-emerald-300 text-emerald-800 text-xs font-semibold text-center">
        ✓ Activation code has been dispatched to your email!
      </div>
    <% } else if (typeof msg !== 'undefined' && msg === 'code_resent') { %>
      <div class="mb-5 p-3.5 rounded-2xl bg-emerald-50 border border-emerald-300 text-emerald-800 text-xs font-semibold text-center">
        ✓ A fresh activation code has been sent to your email.
      </div>
    <% } else if (typeof msg !== 'undefined' && msg === 'activation_required') { %>
      <div class="mb-5 p-3.5 rounded-2xl bg-amber-50 border border-amber-300 text-amber-800 text-xs font-semibold text-center">
        Please complete account activation to sign in.
      </div>
    <% } %>

    <!-- Error Notice -->
    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
      <div class="mb-5 p-4 rounded-2xl bg-rose-50 border border-rose-300 text-rose-800 text-sm font-semibold flex items-start gap-2.5">
        <span class="text-base leading-none">⚠️</span>
        <span><%= errorMessage %></span>
      </div>
    <% } %>

    <!-- OTP Form -->
    <form action="/activation" method="POST" class="space-y-4">
      <input type="hidden" name="email" value="<%= email %>" />

      <div>
        <label for="otp" class="block text-xs font-black uppercase tracking-wider text-slate-700 mb-1 text-center">
          Enter 6-Digit Code
        </label>
        <input
          type="text"
          id="otp"
          name="otp"
          required
          maxlength="6"
          pattern="[0-9]{6}"
          placeholder="123456"
          autocomplete="one-time-code"
          class="w-full text-center tracking-[0.5em] text-2xl font-black px-4 py-3 rounded-xl border-2 border-slate-300 focus:outline-none focus:border-[#ba1414] focus:ring-2 focus:ring-[#ba1414]/20 transition-all text-slate-800 placeholder:text-slate-300 placeholder:tracking-normal placeholder:text-base"
        />
        <div class="flex items-center justify-between mt-2 text-2xs text-slate-400">
          <span>Valid for 2 minutes</span>
          <span class="font-bold text-slate-600">
            <%= typeof remainingAttempts !== 'undefined' ? remainingAttempts : 3 %> attempts remaining
          </span>
        </div>
      </div>

      <div class="pt-2">
        <button
          type="submit"
          class="w-full py-3 px-4 rounded-xl bg-[#ba1414] text-white font-black text-sm hover:bg-[#ba1414]/90 active:scale-[0.99] transition-all shadow-md shadow-[#ba1414]/25 cursor-pointer"
        >
          Activate Account
        </button>
      </div>
    </form>

    <!-- Resend OTP Form (1-minute cooldown) -->
    <div class="mt-6 pt-4 border-t border-slate-100 text-center">
      <p class="text-xs text-slate-500 mb-2">Did not receive the code or need a new one?</p>
      <form action="/activation/resend" method="POST">
        <input type="hidden" name="email" value="<%= email %>" />
        <button
          type="submit"
          id="resend-btn"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl border border-slate-300 hover:border-[#ba1414] text-xs font-bold text-slate-700 hover:text-[#ba1414] hover:bg-[#ba1414]/5 transition-all cursor-pointer"
        >
          🔄 Resend Code
        </button>
      </form>
    </div>

  </div>
</div>

<%- include('../layouts/footer') %>
