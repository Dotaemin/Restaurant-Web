<%- include('../layouts/header') %>

<div class="max-w-md mx-auto my-8">
  <div class="bg-white rounded-3xl border-2 border-[#ba1414]/20 p-8 shadow-xl">
    
    <!-- Header -->
    <div class="text-center mb-6">
      <div class="w-14 h-14 mx-auto rounded-2xl bg-[#ba1414]/10 text-[#ba1414] flex items-center justify-center text-2xl font-black mb-3">
        🔑
      </div>
      <h1 class="text-2xl font-black text-[#ba1414] tracking-tight">Reset Password</h1>
      <p class="text-xs text-slate-500 mt-1">
        Enter your Gmail address and we will send you a link to reset your password.
      </p>
    </div>

    <!-- Success / Dispatched Notice -->
    <% if (typeof infoNotice !== 'undefined' && infoNotice) { %>
      <div class="mb-5 p-4 rounded-2xl bg-emerald-50 border border-emerald-300 text-emerald-800 text-sm font-semibold flex items-start gap-2.5">
        <span class="text-base leading-none">✓</span>
        <span><%= infoNotice %></span>
      </div>
    <% } %>

    <!-- Error Notice -->
    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
      <div class="mb-5 p-4 rounded-2xl bg-rose-50 border border-rose-300 text-rose-800 text-sm font-semibold flex items-start gap-2.5">
        <span class="text-base leading-none">⚠️</span>
        <span><%= errorMessage %></span>
      </div>
    <% } %>

    <!-- Form -->
    <form action="/forget" method="POST" class="space-y-4">
      <div>
        <label for="email" class="block text-xs font-black uppercase tracking-wider text-slate-700 mb-1">
          Gmail Address
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          placeholder="yourname@gmail.com"
          class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:border-[#ba1414] focus:ring-2 focus:ring-[#ba1414]/20 text-sm font-medium transition-all"
        />
        <p class="text-2xs text-slate-400 mt-1">Password reset instructions will only be delivered to your registered email address.</p>
      </div>

      <div class="pt-2">
        <button
          type="submit"
          class="w-full py-3 px-4 rounded-xl bg-[#ba1414] text-white font-black text-sm hover:bg-[#ba1414]/90 active:scale-[0.99] transition-all shadow-md shadow-[#ba1414]/25 cursor-pointer"
        >
          Send Reset Link
        </button>
      </div>
    </form>

    <div class="mt-6 text-center border-t border-slate-100 pt-4">
      <p class="text-xs text-slate-500">
        Remember your password?
        <a href="/login" class="font-bold text-[#ba1414] hover:underline ml-1">Back to Sign In</a>
      </p>
    </div>

  </div>
</div>

<%- include('../layouts/footer') %>
