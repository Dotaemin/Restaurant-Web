<%- include('../layouts/header') %>

<script src="https://www.google.com/recaptcha/api.js" async defer></script>

<div class="max-w-md mx-auto my-8">
  <div class="bg-white rounded-3xl border-2 border-[#ba1414]/20 p-8 shadow-xl">
    
    <!-- Header -->
    <div class="text-center mb-6">
      <div class="w-14 h-14 mx-auto rounded-2xl bg-[#ba1414]/10 text-[#ba1414] flex items-center justify-center text-2xl font-black mb-3">
        🔐
      </div>
      <h1 class="text-2xl font-black text-[#ba1414] tracking-tight">Sign In</h1>
      <p class="text-xs text-slate-500 mt-1">Welcome back to B.H.T Diner</p>
    </div>

    <!-- Success Messages -->
    <% if (typeof msg !== 'undefined' && msg === 'activated') { %>
      <div class="mb-5 p-3.5 rounded-2xl bg-emerald-50 border border-emerald-300 text-emerald-800 text-xs font-semibold text-center">
        ✓ Your account has been activated! Please sign in with your credentials.
      </div>
    <% } else if (typeof msg !== 'undefined' && msg === 'password_reset_success') { %>
      <div class="mb-5 p-3.5 rounded-2xl bg-emerald-50 border border-emerald-300 text-emerald-800 text-xs font-semibold text-center">
        ✓ Password updated successfully! Please sign in with your new password.
      </div>
    <% } else if (typeof msg !== 'undefined' && msg === 'logged_out') { %>
      <div class="mb-5 p-3.5 rounded-2xl bg-slate-50 border border-slate-200 text-slate-700 text-xs font-semibold text-center">
        You have signed out successfully.
      </div>
    <% } %>

    <!-- Error Notice (Never reveal technical details or which field failed) -->
    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
      <div class="mb-5 p-4 rounded-2xl bg-rose-50 border border-rose-300 text-rose-800 text-sm font-semibold flex items-start gap-2.5">
        <span class="text-base leading-none">⚠️</span>
        <span><%= errorMessage %></span>
      </div>
    <% } %>

    <!-- Form -->
    <form action="/login" method="POST" class="space-y-4">
      <div>
        <label for="identifier" class="block text-xs font-black uppercase tracking-wider text-slate-700 mb-1">
          Username or Gmail Address
        </label>
        <div class="relative">
          <input
            type="password"
            id="password"
            name="password"
            required
            placeholder="••••••••"
            class="w-full px-4 py-2.5 pr-11 rounded-xl border border-slate-300 focus:outline-none focus:border-[#ba1414] focus:ring-2 focus:ring-[#ba1414]/20 text-sm font-medium transition-all"
          />
          <button
            type="button"
            onclick="togglePasswordVisibility('password', this)"
            class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 focus:outline-none transition-colors cursor-pointer"
            title="Show password"
            aria-label="Show password"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </button>
        </div>
      </div>

      <!-- Google reCAPTCHA v2 (Shown automatically after 3 failed attempts) -->
      <% if (typeof requireCaptcha !== 'undefined' && requireCaptcha) { %>
        <div class="pt-2 flex flex-col items-center gap-1.5">
          <span class="text-2xs font-bold text-amber-700">Security verification required</span>
          <div class="g-recaptcha" data-sitekey="<%= recaptchaSiteKey %>"></div>
        </div>
      <% } %>

      <!-- Submit Button (Login Bar) -->
      <div class="pt-2">
        <button
          type="submit"
          class="w-full py-3 px-4 rounded-xl bg-[#ba1414] text-white font-black text-sm hover:bg-[#ba1414]/90 active:scale-[0.99] transition-all shadow-md shadow-[#ba1414]/25 cursor-pointer"
        >
          Sign In
        </button>
      </div>

      <!-- Required text below the log in bar: "Forget Password?" -->
      <div class="text-center pt-1">
        <a href="/forget" class="text-xs font-bold text-[#ba1414] hover:underline">
          Forget Password?
        </a>
      </div>
    </form>

    <div class="mt-6 text-center border-t border-slate-100 pt-4">
      <p class="text-xs text-slate-500">
        Don't have an account yet?
        <a href="/register" class="font-bold text-[#ba1414] hover:underline ml-1">Create one here</a>
      </p>
    </div>

  </div>
</div>


<script>
function togglePasswordVisibility(inputId, btn) {
  var input = document.getElementById(inputId);
  if (!input) return;
  var isPassword = input.type === 'password';
  input.type = isPassword ? 'text' : 'password';
  btn.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
  btn.setAttribute('title', isPassword ? 'Hide password' : 'Show password');
  btn.innerHTML = isPassword
    ? '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>'
    : '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>';
}
</script>

<%- include('../layouts/footer') %>
