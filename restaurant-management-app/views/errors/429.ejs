<%- include('../layouts/header') %>

<div class="max-w-lg mx-auto my-12 px-4">
  <div class="bg-white rounded-3xl border-2 border-[#ba1414]/20 p-8 shadow-xl text-center">
    
    <div class="w-16 h-16 mx-auto rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center text-3xl font-black mb-4 border border-amber-200">
      ⏳
    </div>

    <h1 class="text-2xl font-black text-[#ba1414] tracking-tight mb-3">
      <%= typeof title !== 'undefined' && title ? title : 'Please Wait a Moment' %>
    </h1>

    <p class="text-base font-semibold text-slate-700 mb-6 leading-relaxed">
      <%= typeof message !== 'undefined' && message ? message : "You've failed OTP activation too many times. Please wait 5 minutes before retrying." %>
    </p>

    <div class="pt-4 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-center gap-3">
      <a
        href="/login"
        class="w-full sm:w-auto px-6 py-2.5 rounded-xl bg-[#ba1414] text-white font-bold text-sm hover:bg-[#ba1414]/90 transition-all shadow-md shadow-[#ba1414]/25"
      >
        Go to Sign In
      </a>
      <a
        href="/dishes"
        class="w-full sm:w-auto px-6 py-2.5 rounded-xl border border-slate-300 text-slate-700 font-bold text-sm hover:bg-slate-50 transition-all"
      >
        View Menu
      </a>
    </div>

  </div>
</div>

<%- include('../layouts/footer') %>
