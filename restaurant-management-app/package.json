{
  "name": "restaurant-management-app",
  "version": "1.0.0",
  "description": "Server-side rendered restaurant management system with Express, EJS, Tailwind CSS, Prisma ORM, and Supabase",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:css": "npx @tailwindcss/cli -i ./src/input.css -o ./public/css/styles.css --minify",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=prisma/schema.prisma",
    "seed": "node prisma/seed.js",
    "cleanup": "node scripts/cleanup.js",
    "test": "node test/test-api.js",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "client:preview": "npm --prefix client run preview"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "jose": "^6.2.16",
    "method-override": "^3.0.0",
    "nodemailer": "^10.4.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "prisma": "^6.3.1",
    "tailwindcss": "^4.0.0"
  }
}
