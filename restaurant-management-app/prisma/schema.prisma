generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  VIEWER
  CHEF
  ADMIN
}

enum Status {
  PENDING
  ACTIVE
}

model Chef {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  specialty String
  dishes    Dish[]
  user      User?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ingredient {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  unit      String
  dishes    Dish[]   @relation("DishIngredients")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Dish {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  description String
  price       Float
  category    String
  available   Boolean      @default(true)
  imageUrl    String
  chefId      Int
  chef        Chef         @relation(fields: [chefId], references: [id], onDelete: Cascade)
  ingredients Ingredient[] @relation("DishIngredients")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model User {
  id                  Int                  @id @default(autoincrement())
  username            String               @unique
  email               String               @unique
  passwordHash        String
  salt                String
  role                Role                 @default(VIEWER)
  status              Status               @default(PENDING)
  emailVerifiedAt     DateTime?
  
  chefId              Int?                 @unique
  chef                Chef?                @relation(fields: [chefId], references: [id], onDelete: SetNull)

  // Login failed attempt tracking
  failedLoginAttempts Int?                 @default(0)
  lastFailedLoginAt   DateTime?
  lockoutUntil        DateTime?

  // MFA / TOTP fields
  mfaSecret           String?
  mfaEnabled          Boolean              @default(false)
  mfaDrift            Int                  @default(0)
  mfaLastUsedStep     Int?
  mfaFailedAttempts   Int                  @default(0)
  mfaLockedUntil      DateTime?
  recoveryCodeAttempts Int                 @default(0)
  recoveryCodeLockedUntil DateTime?
  recoveryCodes       RecoveryCode[]
  
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  activationChallenge ActivationChallenge?
  passwordChallenges  PasswordChallenge[]

  @@index([email])
  @@index([username])
}

model RecoveryCode {
  id        Int       @id @default(autoincrement())
  userId    Int
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ActivationChallenge {
  id          Int       @id @default(autoincrement())
  userId      Int       @unique
  purpose     String    @default("account_activation")
  otp         String?   // 6-digit plain OTP
  otpHash     String?
  expiresAt   DateTime
  attempts    Int       @default(0)
  lockedUntil DateTime?
  lastSentAt  DateTime?
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordChallenge {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}
