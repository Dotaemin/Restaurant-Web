# ========================================================
# Google Gmail SMTP Settings (Using Nodemailer)
# ========================================================
# How to get Gmail App Password:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Go to App Passwords: https://myaccount.google.com/apppasswords
# 3. Create an App name (e.g. "BHT Diner") and copy the 16-character password generated.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-gmail-app-password"

# ========================================================
# JWT Secret Key (Used by jose library for session tokens)
# ========================================================
JWT_SECRET="replace-with-a-random-secure-string-at-least-32-chars-long"

