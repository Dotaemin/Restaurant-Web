# Supabase PostgreSQL Connection String
# How to get this:
# 1. Go to https://supabase.com/dashboard/project/vxcabjpnmdoiksijkikt/settings/database
# 2. Scroll to "Connection string" -> Select "URI"
# 3. Choose "Direct connection" (Port 5432) or "Connection pooling" (Port 6543)
# 4. Replace [YOUR-PASSWORD] with your actual Supabase database password

# Direct Connection Format (Port 5432):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.vxcabjpnmdoiksijkikt.supabase.co:5432/postgres"

# Connection Pooling Format (Port 6543):
# DATABASE_URL="postgresql://postgres.vxcabjpnmdoiksijkikt:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

DATABASE_URL="postgresql://postgres:YOUR_PASSWORD_HERE@db.vxcabjpnmdoiksijkikt.supabase.co:5432/postgres"

# Local SQLite Database for Offline / Testing Mode
TEST_DATABASE_URL="file:./dev.db"

# Application Port
PORT=3000
