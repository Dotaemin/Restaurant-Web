<!DOCTYPE html>
<html lang="en" class="h-full bg-[#f5f5f5]">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : '429 - Too Many Requests' %> | B.H.T Diner</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="min-h-full flex flex-col font-sans text-slate-800 bg-[#f5f5f5] antialiased p-4 sm:p-6 lg:p-8">

  <!-- Top Navigation Bar with Back Button in the Top Left Corner -->
  <header class="w-full max-w-5xl mx-auto flex items-center justify-between mb-8">
    <a href="<%= typeof backUrl !== 'undefined' && backUrl ? backUrl : '/dishes' %>" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#ba1414] hover:bg-[#991010] text-[#f5f5f5] font-bold text-sm shadow-md shadow-[#ba1414]/20 transition-all">
      <span class="text-base">&larr;</span> Back
    </a>

    <!-- Brand Label -->
    <div class="flex items-center gap-2 text-xs font-black text-[#ba1414] tracking-wider uppercase">
      <span class="w-2.5 h-2.5 rounded-full bg-[#ba1414]"></span>
      B.H.T Diner
    </div>
  </header>

  <!-- Main Error Card -->
  <main class="flex-1 flex items-center justify-center w-full max-w-2xl mx-auto py-6">
    <div class="w-full bg-white rounded-3xl border border-[#ba1414]/20 shadow-xl shadow-[#ba1414]/5 p-8 sm:p-12 text-center">
      
      <!-- Icon & Status Pill -->
      <div class="inline-flex items-center justify-center w-20 h-20 rounded-2xl bg-[#ba1414]/10 text-[#ba1414] font-black text-3xl mb-6 shadow-inner border border-[#ba1414]/20">
        429
      </div>

      <div>
        <span class="inline-block px-3 py-1 rounded-full text-xs font-black uppercase tracking-widest bg-[#ba1414]/10 text-[#ba1414] mb-3">
          Rate Limit Exceeded
        </span>
        <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
          Too Many Requests
        </h1>
      </div>

      <!-- Cause of Rate Limit Error -->
      <div class="mt-6 p-5 rounded-2xl bg-rose-50 border border-rose-300 text-left">
        <div class="text-xs font-bold text-rose-800 uppercase tracking-wider mb-1.5 flex items-center gap-1.5">
          <span class="font-black">⏳</span> Security Cooldown Active:
        </div>
        <p class="text-sm font-bold text-rose-950 break-words leading-relaxed">
          <%= typeof cause !== 'undefined' && cause ? cause : 'You have made too many attempts or requests in a short period. Please wait before trying again.' %>
        </p>
      </div>

      <!-- Guidelines Section -->
      <div class="mt-6 p-4 rounded-xl bg-[#f5f5f5] border border-[#ba1414]/20 text-left text-xs text-slate-700 space-y-1.5">
        <div class="font-bold text-[#ba1414] uppercase tracking-wider text-2xs">Security Policies:</div>
        <ul class="list-disc list-inside space-y-1 text-slate-600">
          <li><strong>Activation OTP Resend:</strong> Must wait at least 1 minute between resend requests.</li>
          <li><strong>Login Security:</strong> Temporarily locked for 5 minutes after 5 consecutive failed attempts.</li>
          <li><strong>Password Reset:</strong> Rate limited to 1 request per 2 minutes.</li>
        </ul>
      </div>

      <!-- Action Button -->
      <div class="mt-8 flex justify-center">
        <a href="<%= typeof backUrl !== 'undefined' && backUrl ? backUrl : '/dishes' %>" class="px-6 py-3 rounded-xl bg-[#ba1414] hover:bg-[#991010] text-[#f5f5f5] font-bold text-sm shadow-md transition-all">
          Return to Previous Page
        </a>
      </div>
    </div>
  </main>

  <footer class="mt-auto py-6 text-center text-xs text-slate-400">
    &copy; B.H.T Diner. All rights reserved.
  </footer>
</body>
</html>
