<%- include('../layouts/header') %>

<main class="flex-1 flex items-center justify-center py-10 px-4 sm:px-6">
  <div class="w-full max-w-md bg-white rounded-3xl border border-[#ba1414]/20 shadow-xl shadow-[#ba1414]/5 p-8 sm:p-10">
    
    <!-- Title Section -->
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-[#ba1414]/10 text-[#ba1414] mb-3 shadow-inner">
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
        </svg>
      </div>
      <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">Admin Login</h1>
      <p class="text-xs text-slate-500 mt-1">Sign in to access restaurant management tools</p>
    </div>

    <!-- Info / Success Alert Banner -->
    <% if (typeof info !== 'undefined' && info) { %>
      <div class="mb-6 p-4 rounded-2xl bg-emerald-50 border border-emerald-300 text-left">
        <div class="text-xs font-bold text-emerald-800 flex items-center gap-1.5">
          <span>✓</span> <%= info %>
        </div>
      </div>
    <% } %>

    <!-- Error Alert Banner -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="mb-6 p-4 rounded-2xl bg-rose-50 border border-rose-300 text-left">
        <div class="text-xs font-bold text-rose-800 uppercase tracking-wider mb-1 flex items-center gap-1.5">
          <span>⚠️</span> Authentication Error
        </div>
        <p class="text-sm font-bold text-rose-950 break-words leading-relaxed">
          <%= error %>
        </p>
      </div>
    <% } %>

    <!-- Login Form -->
    <form action="/login" method="POST" class="space-y-5">
      
      <!-- Username or Email Field -->
      <div class="flex flex-col gap-[3px]">
        <label for="identifier" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-[3px]" style="margin-bottom: 3px;">
          Username or Email *
        </label>
        <input 
          type="text" 
          id="identifier" 
          name="identifier" 
          value="<%= typeof old !== 'undefined' && old.identifier ? old.identifier : '' %>"
          required 
          placeholder="username or user@gmail.com" 
          class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-[#ba1414] focus:ring-2 focus:ring-[#ba1414]/20 outline-none transition-all text-sm font-medium"
        />
      </div>

      <!-- Password Field -->
      <div class="flex flex-col gap-[3px]">
        <label for="password" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-[3px]" style="margin-bottom: 3px;">
          Password *
        </label>
        <input 
          type="password" 
          id="password" 
          name="password" 
          required 
          placeholder="••••••••" 
          class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-[#ba1414] focus:ring-2 focus:ring-[#ba1414]/20 outline-none transition-all text-sm font-medium mb-[3px]"
          style="margin-bottom: 3px;"
        />
      </div>

      <!-- Google reCAPTCHA v2 Widget (enforced if required by brute force detector) -->
      <% if (typeof captchaRequired !== 'undefined' && captchaRequired) { %>
        <div class="flex flex-col items-center pt-2 mb-[3px]" style="margin-bottom: 3px;">
          <p class="text-2xs text-amber-700 mb-2 font-bold">⚠️ Multiple failed attempts detected. Please solve the CAPTCHA:</p>
          <script src="https://www.google.com/recaptcha/api.js" async defer></script>
          <div class="g-recaptcha" data-sitekey="<%= recaptchaSiteKey %>"></div>
        </div>
      <% } %>

      <!-- Submit Button (Log in bar) -->
      <button 
        type="submit" 
        class="w-full py-3.5 px-4 rounded-xl bg-[#ba1414] hover:bg-[#991010] text-[#f5f5f5] font-black text-sm tracking-wide shadow-md shadow-[#ba1414]/20 hover:scale-[1.01] active:scale-[0.99] transition-all cursor-pointer mt-[3px]"
        style="margin-top: 3px;"
      >
        Sign In to B.H.T Diner
      </button>

      <!-- Forget Password Link (below login bar) -->
      <div class="text-center pt-1">
        <a href="/forget" class="text-xs font-bold text-[#ba1414] hover:underline">
          Forget Password?
        </a>
      </div>

      <!-- Registration Link -->
      <div class="text-center pt-4 border-t border-slate-200 text-xs text-slate-500">
        Don't have an account yet? 
        <a href="/register" class="font-bold text-[#ba1414] hover:underline">Register here</a>
      </div>
    </form>

  </div>
</main>

<%- include('../layouts/footer') %>
