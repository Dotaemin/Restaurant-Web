<%- include('../layouts/header') %>

<main class="flex-1 flex items-center justify-center py-10 px-4 sm:px-6">
  <div class="w-full max-w-md bg-white rounded-3xl border border-[#ba1414]/20 shadow-xl shadow-[#ba1414]/5 p-8 sm:p-10">
    
    <!-- Title Section -->
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-[#ba1414]/10 text-[#ba1414] mb-3 shadow-inner">
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
        </svg>
      </div>
      <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">Forgot Password</h1>
      <p class="text-xs text-slate-500 mt-1 max-w-xs mx-auto">
        Enter your registered email address to receive password reset instructions.
      </p>
    </div>

    <!-- Info Banner -->
    <% if (typeof info !== 'undefined' && info) { %>
      <div class="mb-6 p-4 rounded-2xl bg-emerald-50 border border-emerald-300 text-left">
        <div class="text-xs font-bold text-emerald-800 flex items-center gap-1.5 mb-1">
          <span>✓</span> Request Received
        </div>
        <p class="text-xs font-semibold text-emerald-950 leading-relaxed">
          <%= info %>
        </p>
      </div>
    <% } %>

    <!-- Error Banner -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="mb-6 p-4 rounded-2xl bg-rose-50 border border-rose-300 text-left">
        <div class="text-xs font-bold text-rose-800 uppercase tracking-wider mb-1 flex items-center gap-1.5">
          <span>⚠️</span> Error
        </div>
        <p class="text-sm font-bold text-rose-950 break-words leading-relaxed">
          <%= error %>
        </p>
      </div>
    <% } %>

    <!-- Forget Password Form -->
    <form action="/forget" method="POST" class="space-y-5">
      <div>
        <label for="email" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
          Registered Email *
        </label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          required 
          placeholder="yourname@gmail.com" 
          class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-[#ba1414] focus:ring-2 focus:ring-[#ba1414]/20 outline-none transition-all text-sm font-medium"
        />
        <p class="text-2xs text-slate-400 mt-1">Rate limit: 1 request every 2 minutes.</p>
      </div>

      <button 
        type="submit" 
        class="w-full py-3.5 px-4 rounded-xl bg-[#ba1414] hover:bg-[#991010] text-[#f5f5f5] font-black text-sm tracking-wide shadow-md shadow-[#ba1414]/20 hover:scale-[1.01] active:scale-[0.99] transition-all cursor-pointer"
      >
        Send Reset Link
      </button>

      <div class="text-center pt-2 text-xs text-slate-500">
        Remembered your password? 
        <a href="/login" class="font-bold text-[#ba1414] hover:underline">Return to Log In</a>
      </div>
    </form>

  </div>
</main>

<%- include('../layouts/footer') %>
