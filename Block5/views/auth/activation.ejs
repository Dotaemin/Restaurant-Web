<%- include('../layouts/header') %>

<main class="flex-1 flex items-center justify-center py-10 px-4 sm:px-6">
  <div class="w-full max-w-md bg-white rounded-3xl border border-[#ba1414]/20 shadow-xl shadow-[#ba1414]/5 p-8 sm:p-10 text-center">
    
    <!-- Title Section -->
    <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-[#ba1414]/10 text-[#ba1414] mb-3 shadow-inner">
      <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
      </svg>
    </div>
    <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">Account Activation</h1>
    <p class="text-xs text-slate-500 mt-2 max-w-xs mx-auto">
      Enter the 6-digit verification code sent to <strong class="text-slate-800"><%= email %></strong>
    </p>

    <!-- Info Banner -->
    <% if (typeof info !== 'undefined' && info) { %>
      <div class="mt-4 p-3.5 rounded-2xl bg-emerald-50 border border-emerald-300 text-left">
        <div class="text-xs font-bold text-emerald-800 flex items-center gap-1.5">
          <span>✓</span> <%= info %>
        </div>
      </div>
    <% } %>

    <!-- Error Banner -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="mt-4 p-4 rounded-2xl bg-rose-50 border border-rose-300 text-left">
        <div class="text-xs font-bold text-rose-800 uppercase tracking-wider mb-1 flex items-center gap-1.5">
          <span>⚠️</span> Verification Error
        </div>
        <p class="text-sm font-bold text-rose-950 break-words leading-relaxed">
          <%= error %>
        </p>
      </div>
    <% } %>

    <!-- Activation Form -->
    <form action="/activation" method="POST" class="mt-6 space-y-5">
      <input type="hidden" name="email" value="<%= email %>" />

      <div>
        <label for="otp" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
          6-Digit Activation Code
        </label>
        <input 
          type="text" 
          id="otp" 
          name="otp" 
          required 
          maxlength="6" 
          pattern="[0-9]{6}"
          inputmode="numeric"
          autocomplete="one-time-code"
          placeholder="000000" 
          class="w-full text-center text-3xl font-black tracking-widest text-[#ba1414] py-3.5 px-4 rounded-2xl border-2 border-slate-300 focus:border-[#ba1414] focus:ring-4 focus:ring-[#ba1414]/15 outline-none transition-all placeholder:text-slate-300"
        />
        <p class="text-2xs text-slate-400 mt-2">
          ⏱️ The code is valid for <strong>2 minutes</strong>. You have 3 attempts.
        </p>
      </div>

      <!-- Submit Button -->
      <button 
        type="submit" 
        class="w-full py-3.5 px-4 rounded-xl bg-[#ba1414] hover:bg-[#991010] text-[#f5f5f5] font-black text-sm tracking-wide shadow-md shadow-[#ba1414]/20 hover:scale-[1.01] active:scale-[0.99] transition-all cursor-pointer"
      >
        Verify &amp; Activate Account
      </button>
    </form>

    <!-- Resend OTP Form -->
    <div class="mt-6 pt-6 border-t border-slate-200">
      <p class="text-xs text-slate-500 mb-2">Didn't receive the code or code expired?</p>
      <form action="/activation/resend" method="POST">
        <input type="hidden" name="email" value="<%= email %>" />
        <button 
          type="submit" 
          class="px-4 py-2 rounded-xl text-xs font-bold text-[#ba1414] hover:bg-[#ba1414]/10 border border-[#ba1414]/30 transition-all cursor-pointer"
        >
          🔄 Resend New OTP Code
        </button>
      </form>
      <p class="text-2xs text-slate-400 mt-1.5">Note: 1 minute cooldown between resends.</p>
    </div>

  </div>
</main>

<%- include('../layouts/footer') %>
