<%- include('../layouts/header') %>

<!-- Admin Dishes View -->
<div class="space-y-8">

  <!-- Top Action Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-4 border-b border-[#ba1414]/20">
    <div>
      <h1 class="text-2xl sm:text-3xl font-black text-[#ba1414] tracking-tight flex items-center gap-2">
        <span>📋</span> Dishes Management
      </h1>
      <p class="text-sm text-slate-500 mt-1">
        Manage restaurant dishes. Add, update, or remove dishes from the menu.
      </p>
    </div>
    <div class="flex items-center gap-3">
      <span class="text-xs font-bold px-3 py-1.5 rounded-full bg-[#ba1414]/10 text-[#ba1414] border border-[#ba1414]/20">
        <%= dishes.length %> Total Dishes
      </span>
      <a href="#new-dish-form" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-[#ba1414] hover:bg-[#991010] text-[#f5f5f5] font-bold text-sm shadow-md shadow-[#ba1414]/20 transition-all">
        + Add New Dish
      </a>
    </div>
  </div>

  <!-- Mobile Stacked Cards (Visible only on screens < 768px, zero sideways scroll) -->
  <div class="md:hidden space-y-4">
    <% if (dishes && dishes.length > 0) { %>
      <% dishes.forEach(dish => { %>
        <div class="bg-white rounded-2xl border border-[#ba1414]/20 p-4 shadow-sm flex flex-col gap-3">
          
          <!-- Top Row: Preview Image + Name + ID + Price -->
          <div class="flex items-start gap-3">
            <img src="<%= dish.imageUrl %>" alt="<%= dish.name %>" class="w-16 h-16 rounded-xl object-cover border border-[#ba1414]/20 shrink-0">
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between gap-1">
                <span class="text-xs font-mono font-bold text-slate-400">#<%= dish.id %></span>
                <span class="text-base font-black text-[#ba1414]">$<%= dish.price.toFixed(2) %></span>
              </div>
              <a href="/admin/dishes/<%= dish.id %>" class="font-extrabold text-slate-900 hover:text-[#ba1414] text-base leading-snug block mt-0.5">
                <%= dish.name %>
              </a>
              <p class="text-xs text-slate-500 line-clamp-2 mt-1"><%= dish.description %></p>
            </div>
          </div>

          <!-- Middle Attributes: Category, Status, Chef, Ingredients -->
          <div class="grid grid-cols-2 gap-2 text-xs pt-2 border-t border-slate-100">
            <div class="bg-[#f5f5f5] p-2 rounded-xl">
              <span class="text-slate-400 font-bold block text-2xs uppercase">Category</span>
              <span class="font-bold text-[#ba1414] whitespace-nowrap"><%= dish.category %></span>
            </div>
            <div class="bg-[#f5f5f5] p-2 rounded-xl">
              <span class="text-slate-400 font-bold block text-2xs uppercase">Status</span>
              <% if (dish.available) { %>
                <span class="font-bold text-emerald-700">● Active</span>
              <% } else { %>
                <span class="font-bold text-slate-500">Unavailable</span>
              <% } %>
            </div>
            <div class="bg-[#f5f5f5] p-2 rounded-xl">
              <span class="text-slate-400 font-bold block text-2xs uppercase">Chef</span>
              <span class="font-medium text-slate-700 truncate block"><%= dish.chef ? dish.chef.name : 'None' %></span>
            </div>
            <div class="bg-[#f5f5f5] p-2 rounded-xl">
              <span class="text-slate-400 font-bold block text-2xs uppercase">Ingredients</span>
              <span class="font-medium text-slate-700"><%= dish.ingredients ? dish.ingredients.length : 0 %> items</span>
            </div>
          </div>

          <!-- Bottom Actions: Edit and Delete -->
          <div class="flex items-center gap-2 pt-2 border-t border-slate-100">
            <a href="/admin/dishes/<%= dish.id %>" class="flex-1 py-2 text-center rounded-xl text-xs font-bold bg-[#ba1414]/10 text-[#ba1414] hover:bg-[#ba1414]/20 border border-[#ba1414]/30 transition-colors">
              Edit
            </a>
            <form method="POST" action="/admin/dishes/<%= dish.id %>?_method=DELETE" class="flex-1">
              <input type="hidden" name="_method" value="DELETE">
              <button type="submit" class="w-full py-2 text-center rounded-xl text-xs font-bold bg-rose-50 text-rose-700 hover:bg-rose-100 border border-rose-200 transition-colors">
                Delete
              </button>
            </form>
          </div>

        </div>
      <% }) %>
    <% } else { %>
      <div class="bg-white rounded-2xl border border-dashed border-[#ba1414]/30 p-6 text-center text-slate-400 italic text-sm">
        No dishes found. Fill the form below to add your first dish.
      </div>
    <% } %>
  </div>

  <!-- Desktop Tabular Display of Dishes (Hidden on mobile < 768px) -->
  <div class="hidden md:block bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-sm">
        <thead>
          <tr class="bg-slate-50 border-b border-slate-200 text-slate-600 font-bold text-xs uppercase tracking-wider">
            <th class="py-3.5 px-4">ID</th>
            <th class="py-3.5 px-4">Preview</th>
            <th class="py-3.5 px-4">Name</th>
            <th class="py-3.5 px-4 whitespace-nowrap">Category</th>
            <th class="py-3.5 px-4">Price</th>
            <th class="py-3.5 px-4">Chef</th>
            <th class="py-3.5 px-4">Ingredients</th>
            <th class="py-3.5 px-4">Status</th>
            <th class="py-3.5 px-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-slate-700">
          <% if (dishes && dishes.length > 0) { %>
            <% dishes.forEach(dish => { %>
              <tr class="hover:bg-[#ba1414]/5 transition-colors">
                <td class="py-3 px-4 font-mono text-xs font-bold text-slate-400">
                  #<%= dish.id %>
                </td>
                <td class="py-3 px-4">
                  <img src="<%= dish.imageUrl %>" alt="<%= dish.name %>" class="w-12 h-12 object-cover rounded-lg border border-slate-200 shadow-2xs">
                </td>
                <td class="py-3 px-4">
                  <a href="/admin/dishes/<%= dish.id %>" class="font-bold text-slate-900 hover:text-[#ba1414] transition-colors">
                    <%= dish.name %>
                  </a>
                  <p class="text-xs text-slate-400 line-clamp-1 max-w-xs"><%= dish.description %></p>
                </td>
                <td class="py-3 px-4 whitespace-nowrap">
                  <span class="inline-block whitespace-nowrap px-2.5 py-1 rounded-full text-xs font-bold bg-[#ba1414]/10 text-[#ba1414] border border-[#ba1414]/20">
                    <%= dish.category %>
                  </span>
                </td>
                <td class="py-3 px-4 font-bold text-slate-900">
                  $<%= dish.price.toFixed(2) %>
                </td>
                <td class="py-3 px-4 text-xs font-medium text-slate-600">
                  <%= dish.chef ? dish.chef.name : 'None' %>
                </td>
                <td class="py-3 px-4">
                  <span class="text-xs text-slate-500 font-medium">
                    <%= dish.ingredients ? dish.ingredients.length : 0 %> items
                  </span>
                </td>
                <td class="py-3 px-4">
                  <% if (dish.available) { %>
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Active
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-500 border border-slate-200">
                      Unavailable
                    </span>
                  <% } %>
                </td>
                <td class="py-3 px-4 text-right">
                  <div class="inline-flex items-center gap-2">
                    <!-- Edit Link -->
                    <a href="/admin/dishes/<%= dish.id %>" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-[#ba1414]/10 text-[#ba1414] hover:bg-[#ba1414]/20 border border-[#ba1414]/30 transition-colors">
                      Edit
                    </a>

                    <!-- Delete Form -->
                    <form method="POST" action="/admin/dishes/<%= dish.id %>?_method=DELETE" class="inline">
                      <input type="hidden" name="_method" value="DELETE">
                      <button type="submit" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-rose-50 text-rose-700 hover:bg-rose-100 border border-rose-200 transition-colors">
                        Delete
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="9" class="py-8 text-center text-slate-400 italic">
                No dishes found. Fill the form below to add your first dish.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Add New Dish Form -->
  <div id="new-dish-form" class="bg-white rounded-2xl border border-[#ba1414]/20 p-6 sm:p-8 shadow-sm">
    <div class="border-b border-slate-100 pb-4 mb-6">
      <h2 class="text-xl font-black text-[#ba1414] flex items-center gap-2">
        <span>➕</span> Add New Dish
      </h2>
      <p class="text-xs text-slate-500 mt-1">
        Add a new dish to the restaurant menu below.
      </p>
    </div>

    <form method="POST" action="/admin/dishes" class="space-y-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <!-- Dish Name -->
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
            Dish Name *
          </label>
          <input 
            type="text" 
            name="name" 
            required 
            placeholder="e.g. Truffle Pappardelle" 
            class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-hidden focus:ring-2 focus:ring-[#ba1414] text-sm"
          >
        </div>

        <!-- Price -->
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
            Price (USD) * <span class="text-xs text-slate-400 font-normal lowercase">(non-negative)</span>
          </label>
          <input 
            type="number" 
            step="0.01" 
            min="0"
            name="price" 
            required 
            placeholder="e.g. 24.50" 
            class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-hidden focus:ring-2 focus:ring-[#ba1414] text-sm"
          >
        </div>

        <!-- Category -->
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
            Category *
          </label>
          <select name="category" required class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-hidden focus:ring-2 focus:ring-[#ba1414] text-sm bg-white">
            <option value="Main Course">Main Course</option>
            <option value="Appetizer">Appetizer</option>
            <option value="Dessert">Dessert</option>
            <option value="Beverage">Beverage</option>
          </select>
        </div>

        <!-- Chef Selection -->
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
            Chef *
          </label>
          <select name="chefId" required class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-hidden focus:ring-2 focus:ring-[#ba1414] text-sm bg-white">
            <% if (chefs && chefs.length > 0) { %>
              <% chefs.forEach(chef => { %>
                <option value="<%= chef.id %>"><%= chef.name %> (<%= chef.specialty %>)</option>
              <% }) %>
            <% } else { %>
              <option value="">No chefs available (Add a chef first)</option>
            <% } %>
          </select>
        </div>

        <!-- Image URL -->
        <div class="sm:col-span-2">
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
            Image URL
          </label>
          <input 
            type="url" 
            name="imageUrl" 
            placeholder="https://images.unsplash.com/..." 
            class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-hidden focus:ring-2 focus:ring-[#ba1414] text-sm"
          >
        </div>

      </div>

      <!-- Description -->
      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
          Description *
        </label>
        <textarea 
          name="description" 
          rows="3" 
          required
          placeholder="Brief description of culinary techniques and flavor profile..."
          class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-hidden focus:ring-2 focus:ring-[#ba1414] text-sm"
        ></textarea>
      </div>

      <!-- Availability Toggle -->
      <div class="flex items-center gap-2">
        <input type="checkbox" id="available" name="available" checked class="w-4 h-4 text-[#ba1414] rounded-md border-slate-300 focus:ring-[#ba1414]">
        <label for="available" class="text-sm font-semibold text-slate-700 cursor-pointer">
          Available on Menu
        </label>
      </div>

      <!-- Ingredients Selection Checkboxes -->
      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
          Select Ingredients * <span class="text-xs text-rose-600 font-normal lowercase">(must choose at least one)</span>
        </label>
        <% if (ingredients && ingredients.length > 0) { %>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 p-4 rounded-xl bg-[#f5f5f5] border border-[#ba1414]/20">
            <% ingredients.forEach(ing => { %>
              <label class="flex items-center gap-2 text-xs text-slate-700 cursor-pointer hover:text-[#ba1414]">
                <input type="checkbox" name="ingredientIds" value="<%= ing.id %>" class="w-4 h-4 text-[#ba1414] rounded-md border-slate-300">
                <span><%= ing.name %> (<%= ing.unit %>)</span>
              </label>
            <% }) %>
          </div>
        <% } else { %>
          <p class="text-xs text-slate-400 italic">No ingredients available. Create ingredients first.</p>
        <% } %>
      </div>

      <!-- Submit Button -->
      <div class="pt-2">
        <button type="submit" class="px-6 py-2.5 rounded-xl bg-[#ba1414] hover:bg-[#991010] text-[#f5f5f5] font-bold text-sm shadow-md shadow-[#ba1414]/20 transition-all">
          Save Dish
        </button>
      </div>
    </form>
  </div>

</div>

<%- include('../layouts/footer') %>
